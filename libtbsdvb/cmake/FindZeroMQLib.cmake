# Locates libzmq and provides the imported target tbs::zmq.
# Tries, in order: the upstream CMake package (vcpkg/conan/Homebrew), pkg-config, plain search.
if(TARGET tbs::zmq)
    return()
endif()

find_package(ZeroMQ CONFIG QUIET)
if(ZeroMQ_FOUND)
    foreach(_t libzmq libzmq-static)
        if(TARGET ${_t})
            add_library(tbs::zmq INTERFACE IMPORTED)
            target_link_libraries(tbs::zmq INTERFACE ${_t})
            message(STATUS "Found ZeroMQ (CMake package, target ${_t})")
            return()
        endif()
    endforeach()
endif()

find_package(PkgConfig QUIET)
if(PKG_CONFIG_FOUND)
    pkg_check_modules(TBS_ZMQ QUIET IMPORTED_TARGET libzmq)
    if(TBS_ZMQ_FOUND)
        add_library(tbs::zmq INTERFACE IMPORTED)
        target_link_libraries(tbs::zmq INTERFACE PkgConfig::TBS_ZMQ)
        message(STATUS "Found ZeroMQ ${TBS_ZMQ_VERSION} (pkg-config)")
        return()
    endif()
endif()

find_path(TBS_ZMQ_INCLUDE_DIR zmq.h)
find_library(TBS_ZMQ_LIBRARY NAMES zmq libzmq libzmq-mt-4_3_5 libzmq-mt-4_3_4)
if(TBS_ZMQ_INCLUDE_DIR AND TBS_ZMQ_LIBRARY)
    add_library(tbs::zmq INTERFACE IMPORTED)
    target_include_directories(tbs::zmq INTERFACE ${TBS_ZMQ_INCLUDE_DIR})
    target_link_libraries(tbs::zmq INTERFACE ${TBS_ZMQ_LIBRARY})
    message(STATUS "Found ZeroMQ: ${TBS_ZMQ_LIBRARY}")
endif()
