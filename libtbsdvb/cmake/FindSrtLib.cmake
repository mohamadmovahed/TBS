# Locates libsrt and provides the imported target tbs::srt.
# Tries the upstream CMake package, pkg-config (srt or srt-gnutls), then a plain search.
if(TARGET tbs::srt)
    return()
endif()

find_package(srt CONFIG QUIET)
if(srt_FOUND)
    foreach(_t srt::srt_shared srt::srt_static srt_shared srt_static)
        if(TARGET ${_t})
            add_library(tbs::srt INTERFACE IMPORTED)
            target_link_libraries(tbs::srt INTERFACE ${_t})
            message(STATUS "Found SRT (CMake package, target ${_t})")
            return()
        endif()
    endforeach()
endif()

find_package(PkgConfig QUIET)
if(PKG_CONFIG_FOUND)
    pkg_check_modules(TBS_SRT QUIET IMPORTED_TARGET srt)
    if(NOT TBS_SRT_FOUND)
        pkg_check_modules(TBS_SRT QUIET IMPORTED_TARGET srt-gnutls)
    endif()
    if(TBS_SRT_FOUND)
        add_library(tbs::srt INTERFACE IMPORTED)
        target_link_libraries(tbs::srt INTERFACE PkgConfig::TBS_SRT)
        message(STATUS "Found SRT ${TBS_SRT_VERSION} (pkg-config)")
        return()
    endif()
endif()

find_path(TBS_SRT_INCLUDE_DIR srt/srt.h)
find_library(TBS_SRT_LIBRARY NAMES srt srt-gnutls srt_static)
if(TBS_SRT_INCLUDE_DIR AND TBS_SRT_LIBRARY)
    add_library(tbs::srt INTERFACE IMPORTED)
    target_include_directories(tbs::srt INTERFACE ${TBS_SRT_INCLUDE_DIR})
    target_link_libraries(tbs::srt INTERFACE ${TBS_SRT_LIBRARY})
    if(WIN32)
        target_link_libraries(tbs::srt INTERFACE ws2_32)
    endif()
    message(STATUS "Found SRT: ${TBS_SRT_LIBRARY}")
endif()
