# libswresample (audio conversion for the preview), optional: tbs::swresample
find_package(PkgConfig QUIET)
if(NOT TARGET tbs::swresample)
    if(PKG_CONFIG_FOUND)
        pkg_check_modules(TBS_SWR QUIET IMPORTED_TARGET libswresample)
        if(TBS_SWR_FOUND)
            add_library(tbs::swresample INTERFACE IMPORTED)
            target_link_libraries(tbs::swresample INTERFACE PkgConfig::TBS_SWR)
        endif()
    endif()
    if(NOT TARGET tbs::swresample)
        find_library(TBS_FFMPEG_swresample_LIBRARY NAMES swresample
            HINTS ${FFMPEG_ROOT} ENV FFMPEG_ROOT PATH_SUFFIXES lib)
        if(TBS_FFMPEG_swresample_LIBRARY)
            add_library(tbs::swresample INTERFACE IMPORTED)
            target_link_libraries(tbs::swresample INTERFACE ${TBS_FFMPEG_swresample_LIBRARY})
        endif()
    endif()
endif()
